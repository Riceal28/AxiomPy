QWidget {
    background: #202225;
    color: #e6e6e6;
    font-family: "Segoe UI";
    font-size: 9pt;
}
QMainWindow::separator {
    background: #31343a;
    width: 4px;
    height: 4px;
}
QMenuBar {
    background: #202225;
    color: #e6e6e6;
    border-bottom: 1px solid #34373d;
}
QMenuBar::item {
    background: transparent;
    padding: 4px 10px;
}
QMenuBar::item:selected,
QMenuBar::item:pressed {
    background: #343840;
}
QMenu {
    background: #25272b;
    color: #e6e6e6;
    border: 1px solid #3b3f46;
    padding: 4px;
}
QMenu::item {
    padding: 5px 24px;
}
QMenu::item:selected {
    background: #3a6ea5;
    color: #ffffff;
}
QMenu::item:disabled {
    color: #6f747c;
}
QTabWidget::pane {
    border: 1px solid #34373d;
    background: #25272b;
}
QGroupBox#pathPanel {
    background: #26292e;
    border: 1px solid #3b3f46;
    border-radius: 6px;
    margin-top: 8px;
}
QGroupBox#pathPanel::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 5px;
    color: #aeb4bc;
}
QLabel#presetHint {
    color: #d5b46a;
    padding: 3px 4px 1px 4px;
}
QLabel#autoPathHint {
    color: #8f959d;
    padding-left: 4px;
}
QTabBar::tab {
    background: #2b2e33;
    color: #c9c9c9;
    padding: 7px 16px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
}
QTabBar::tab:selected {
    background: #3a6ea5;
    color: white;
}
QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox, QTextEdit, QListWidget {
    background: #17191c;
    border: 1px solid #3b3f46;
    border-radius: 3px;
    padding: 4px;
    selection-background-color: #3a6ea5;
}
QLineEdit:disabled, QComboBox:disabled, QSpinBox:disabled,
QDoubleSpinBox:disabled, QTextEdit:disabled, QListWidget:disabled {
    color: #6f747c;
    background: #1b1d20;
    border-color: #2c3036;
}
QCheckBox:disabled, QLabel:disabled, QPushButton:disabled {
    color: #6f747c;
}
QPushButton:disabled {
    background: #2a2d32;
    border-color: #34373d;
}
QComboBox QAbstractItemView {
    background: #1d1f23;
    border: 1px solid #3b3f46;
}
QTableWidget, QTableView {
    background: #17191c;
    alternate-background-color: #1d2024;
    border: 1px solid #3b3f46;
    gridline-color: #3a3f47;
    selection-background-color: #3a6ea5;
    selection-color: #ffffff;
}
QHeaderView {
    background: #30353c;
}
QHeaderView::section {
    background: #30353c;
    color: #f2f4f7;
    padding: 5px 6px;
    border: none;
    border-right: 1px solid #4a5059;
    border-bottom: 1px solid #4a5059;
    font-weight: 600;
}
QHeaderView::section:hover {
    background: #3a4048;
}
QTableCornerButton::section {
    background: #30353c;
    border: none;
    border-right: 1px solid #4a5059;
    border-bottom: 1px solid #4a5059;
}
QPushButton {
    background: #343840;
    border: 1px solid #474c55;
    border-radius: 4px;
    padding: 5px 12px;
}
QPushButton:hover {
    background: #3e444d;
}
QPushButton:pressed {
    background: #2b3037;
}
QCheckBox::indicator {
    width: 14px;
    height: 14px;
    border: 1px solid #5a606a;
    background: #17191c;
}
QCheckBox::indicator:checked {
    background: #3a6ea5;
}
QTableView::indicator, QTableWidget::indicator {
    width: 18px;
    height: 18px;
    border: 2px solid #8a93a0;
    border-radius: 4px;
    background: #101317;
}
QTableView::indicator:hover, QTableWidget::indicator:hover {
    border-color: #b7d4f2;
    background: #1c232b;
}
QTableView::indicator:checked, QTableWidget::indicator:checked {
    background: #2f7fce;
    border: 2px solid #a8d4ff;
}
QTableView::indicator:checked:hover, QTableWidget::indicator:checked:hover {
    background: #3c93e5;
}
QTableView::indicator:disabled, QTableWidget::indicator:disabled {
    border-color: #454b54;
    background: #181a1e;
}
QDockWidget::title {
    background: #2b2e33;
    padding: 5px;
}
