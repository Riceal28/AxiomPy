QWidget {
    background: #202225;
    color: #e6e6e6;
    font-family: "Segoe UI";
    font-size: 9pt;
}
QMainWindow::separator {
    background: #31343a;
    width: 4px;
    height: 4px;
}
QTabWidget::pane {
    border: 1px solid #34373d;
    background: #25272b;
}
QTabBar::tab {
    background: #2b2e33;
    color: #c9c9c9;
    padding: 7px 16px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
}
QTabBar::tab:selected {
    background: #3a6ea5;
    color: white;
}
QLineEdit, QComboBox, QSpinBox, QTextEdit, QListWidget {
    background: #17191c;
    border: 1px solid #3b3f46;
    border-radius: 3px;
    padding: 4px;
    selection-background-color: #3a6ea5;
}
QComboBox QAbstractItemView {
    background: #1d1f23;
    border: 1px solid #3b3f46;
}
QPushButton {
    background: #343840;
    border: 1px solid #474c55;
    border-radius: 4px;
    padding: 5px 12px;
}
QPushButton:hover {
    background: #3e444d;
}
QPushButton:pressed {
    background: #2b3037;
}
QCheckBox::indicator {
    width: 14px;
    height: 14px;
    border: 1px solid #5a606a;
    background: #17191c;
}
QCheckBox::indicator:checked {
    background: #3a6ea5;
}
QDockWidget::title {
    background: #2b2e33;
    padding: 5px;
}
